{
  "name": "pi-easy-bg",
  "version": "3.0.0",
  "description": "Background shell tasks for pi: start long commands without blocking the chat, then inspect or handle results on demand.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "background",
    "jobs",
    "async",
    "tasks"
  ],
  "license": "MIT",
  "author": "Matt Shen <lovelywib@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattshen/pi-easy-bg.git"
  },
  "bugs": {
    "url": "https://github.com/mattshen/pi-easy-bg/issues"
  },
  "homepage": "https://github.com/mattshen/pi-easy-bg#readme",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./extensions/easy-bg.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "files": [
    "extensions/",
    "src/",
    "test/",
    "scripts/",
    "docs/",
    "examples/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-imports.mjs",
    "test": "node --test test/core.test.ts",
    "integration-test": "node scripts/integration-test.mjs",
    "verify": "npm run check && npm test"
  }
}
